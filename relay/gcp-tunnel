#!/usr/bin/env python3
"""gcp-tunnel: the relay of the always-on Remote Compute on Google Compute Engine, from nothing to running, with gcloud.

    gcp-tunnel up --project my-project --domain mcp.example.com   create or update everything; safe to run again
    gcp-tunnel status                                             what exists, and whether it works
    gcp-tunnel nix                                                the settings for the box (relay.nix)
    gcp-tunnel ssh [COMMAND]                                      log in to the relay as its administrator
    gcp-tunnel logs                                               what the relay's startup script said
    gcp-tunnel down [--keep-address]                              delete it all again

`up` remembers what it was given, so afterwards a plain `gcp-tunnel up` brings the relay to that state again, and
does nothing where it already is. It makes and keeps everything it needs in .tunnel/ at the top of this checkout
(ignored by git): the relay's SSH host key, so that a relay made again is still the one the box trusts, an
administrator key for `ssh`, the box's tunnel key, and relay.nix. The TLS certificate is not among them: Caddy, on
the relay, gets it from Let's Encrypt once the domain points there.

What it makes in the project, all named after --name (default mcp-relay): a VPC network with two firewall rules
(80 and 443 from anywhere, 22 from --ssh-from), a static external address, and an e2-micro Debian instance with no
service account. With --dns-zone it also keeps the domain's A record in that Cloud DNS zone.

Needs gcloud (logged in: gcloud auth login), ssh and ssh-keygen. On NixOS without gcloud, it fetches it with nix.
"""

import argparse
import contextlib
import fcntl
import hashlib
import json
import os
import re
import shutil
import socket
import ssl
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
STARTUP = HERE / "startup.sh"
DIR = Path(os.environ.get("GCP_TUNNEL_DIR") or HERE.parent / ".tunnel")
BOX_TUNNEL_KEY = Path("/var/lib/mcp-tunnel/id_ed25519.pub")

DEFAULTS = {
    "project": None,
    "domain": None,
    "name": "mcp-relay",
    # The regions Google's free tier has covered an e2-micro in: us-west1, us-central1, us-east1.
    "region": "us-east1",
    "zone": None,
    "machine_type": "e2-micro",
    "image_family": "debian-12",
    "image_project": "debian-cloud",
    "disk_gb": 10,
    "disk_type": "pd-standard",
    "acme_email": None,
    "dns_zone": None,
    "ssh_from": ["0.0.0.0/0"],
    "admin": "relay-admin",
}
# What `up` may be told and remembers.
SETTINGS = [k for k in DEFAULTS]
WAIT_READY_S = 15 * 60
NOT_FOUND = re.compile(r"was not found|not found|notFound|HTTPError 404|does not exist", re.I)
KEY_RE = re.compile(r"^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp[0-9]+) [A-Za-z0-9+/=]+( [A-Za-z0-9@._-]+)?$")


def say(*parts):
    print(*parts, flush=True)


def die(msg):
    sys.exit("gcp-tunnel: " + msg)


# ---------- settings and files ----------


class Files:
    """What is kept in .tunnel/."""

    def __init__(self, root):
        self.root = Path(root)
        self.config = self.root / "config.json"
        self.host_key = self.root / "host_ed25519"
        self.admin_key = self.root / "admin_ed25519"
        self.tunnel_key = self.root / "tunnel_key.pub"
        self.known_hosts = self.root / "known_hosts"
        self.relay_nix = self.root / "relay.nix"
        self.readme = self.root / "README"

    def ensure_dir(self):
        self.root.mkdir(mode=0o700, parents=True, exist_ok=True)
        os.chmod(self.root, 0o700)
        if not self.readme.exists():
            self.readme.write_text(README)

    def load(self):
        cfg = dict(DEFAULTS)
        if self.config.exists():
            cfg.update(json.loads(self.config.read_text()))
        return cfg

    def save(self, cfg):
        keep = {k: cfg[k] for k in SETTINGS if cfg.get(k) != DEFAULTS[k] or k in ("project", "domain")}
        write(self.config, json.dumps(keep, indent=2, sort_keys=True) + "\n", 0o600)


README = """This directory is made and used by relay/gcp-tunnel. Keep it: it is what makes `gcp-tunnel up` repeatable.

config.json        what `up` was told: project, domain, region and so on
host_ed25519       the relay's SSH host key; the box trusts the relay by it (relay.hostPublicKey)
admin_ed25519      the key `gcp-tunnel ssh` logs in to the relay with
tunnel_key.pub     the box's tunnel key, copied from /var/lib/mcp-tunnel/id_ed25519.pub there
known_hosts        the relay's host key, for ssh
relay.nix          the settings for the box: services.compu-connect.domain, relay.host, relay.hostPublicKey

host_ed25519 also lives in the relay's instance metadata, where anyone who can read the project's instances can
read it. Deleting this directory and running `up` again makes new keys, and the box must then be given the new
relay.nix.
"""


def write(path, text, mode=0o644):
    tmp = Path(str(path) + ".new")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def keygen(path, comment):
    if path.exists():
        return False
    subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", comment, "-f", str(path)], check=True)
    os.chmod(path, 0o600)
    return True


def public(path):
    """`ssh-ed25519 AAAA…`, without the comment."""
    return " ".join(Path(str(path) + ".pub").read_text().split()[:2])


def read_key(path):
    text = Path(path).read_text().strip().splitlines()
    line = text[0].strip() if text else ""
    if not KEY_RE.match(line):
        die("%s is not one line of an SSH public key" % path)
    return line


# ---------- gcloud ----------


class GCloud:
    def __init__(self, project, dry_run=False):
        self.project = project
        self.dry_run = dry_run

    def run(self, *args, mutate=False, check=True, quiet=False):
        """(ok, stdout, stderr)."""
        argv = ["gcloud", *args, "--quiet"] + (["--project=" + self.project] if self.project else [])
        if mutate:
            if self.dry_run:
                say("  would run: " + " ".join(a if " " not in a else repr(a) for a in argv))
                return True, "", ""
            if not quiet:
                say("  $ " + " ".join(argv[:4]) + (" …" if len(argv) > 4 else ""))
        r = subprocess.run(argv, capture_output=True, text=True)
        if r.returncode != 0 and check:
            die("%s failed:\n%s" % (" ".join(argv[:5]), r.stderr.strip()))
        return r.returncode == 0, r.stdout, r.stderr

    def get(self, *args):
        """A resource as JSON, or None if it does not exist."""
        ok, out, err = self.run(*args, "--format=json", check=False)
        if ok:
            return json.loads(out or "null")
        if NOT_FOUND.search(err):
            return None
        die("gcloud %s failed:\n%s" % (" ".join(args[:4]), err.strip()))


def find_gcloud():
    if shutil.which("gcloud"):
        return
    if shutil.which("nix") and not os.environ.get("GCP_TUNNEL_IN_NIX_SHELL"):
        say("gcloud is not installed here; fetching it with nix…")
        os.environ["GCP_TUNNEL_IN_NIX_SHELL"] = "1"
        os.execvp("nix", ["nix", "--extra-experimental-features", "nix-command flakes", "shell",
                          "nixpkgs#google-cloud-sdk", "nixpkgs#openssh", "--command",
                          sys.executable, str(Path(__file__).resolve()), *sys.argv[1:]])  # fmt: skip
    die("gcloud is not installed: https://cloud.google.com/sdk/docs/install")


def zone_of(cfg):
    return cfg["zone"] or cfg["region"] + "-b"


# ---------- what the relay should be ----------


def tunnel_key_of(files, given=None):
    """The box's tunnel key: the one given now, the one kept, or, on the box itself, its own; or None."""
    if given:
        return read_key(given)
    if files.tunnel_key.exists():
        return read_key(files.tunnel_key)
    if os.access(BOX_TUNNEL_KEY, os.R_OK):
        return read_key(BOX_TUNNEL_KEY)
    return None


def desired_metadata(cfg, files, tunnel_key=None):
    md = {
        "startup-script": STARTUP.read_text(),
        "mcp-domain": cfg["domain"],
        "mcp-host-key": files.host_key.read_text(),
        "enable-guest-attributes": "TRUE",
        "block-project-ssh-keys": "TRUE",
        "enable-oslogin": "FALSE",
        "ssh-keys": "%s:%s %s" % (cfg["admin"], public(files.admin_key), cfg["admin"]),
    }
    tunnel_key = tunnel_key or tunnel_key_of(files)
    if tunnel_key:
        md["mcp-tunnel-key"] = tunnel_key
    if cfg["acme_email"]:
        md["mcp-acme-email"] = cfg["acme_email"]
    md["mcp-revision"] = hashlib.sha256(json.dumps(md, sort_keys=True).encode()).hexdigest()[:12]
    return md


# Keys this tool sets, and so may remove when the settings no longer have them.
MANAGED = {"mcp-tunnel-key", "mcp-acme-email"}


def metadata_of(inst):
    return {i["key"]: i.get("value", "") for i in (inst.get("metadata") or {}).get("items") or []}


def last(url):
    return (url or "").rstrip("/").split("/")[-1]


def nat_ip(inst):
    for ni in inst.get("networkInterfaces") or []:
        for ac in ni.get("accessConfigs") or []:
            if ac.get("natIP"):
                return ac["natIP"]
    return None


def guest_status(gc, cfg):
    ok, out, _ = gc.run("compute", "instances", "get-guest-attributes", cfg["name"], "--zone=" + zone_of(cfg),
                        "--query-path=mcp/status", "--format=json", check=False)  # fmt: skip
    if not ok:
        return None
    try:
        rows = json.loads(out or "[]")
    except ValueError:
        return None
    for r in rows if isinstance(rows, list) else []:
        if r.get("key") == "status":
            return r.get("value")
    return None


def rules_of(fw):
    return sorted("%s:%s" % (a["IPProtocol"], p) for a in fw.get("allowed") or [] for p in a.get("ports") or [""])


def firewall_rules(cfg):
    """{name: (rules, source ranges)}"""
    return {
        cfg["name"] + "-web": (["tcp:443", "tcp:80"], ["0.0.0.0/0"]),
        cfg["name"] + "-ssh": (["tcp:22"], sorted(cfg["ssh_from"])),
    }


# ---------- checks from outside ----------


def resolve(domain):
    try:
        return sorted({a[4][0] for a in socket.getaddrinfo(domain, 443, socket.AF_INET, socket.SOCK_STREAM)})
    except OSError:
        return []


def https_check(ip, domain):
    """(certificate expiry or None, HTTP status or None, what went wrong or None), asking the relay's address directly
    for the domain, so that a stale DNS cache here does not matter."""
    ctx = ssl.create_default_context()
    try:
        with socket.create_connection((ip, 443), timeout=10) as raw:
            with ctx.wrap_socket(raw, server_hostname=domain) as s:
                expiry = s.getpeercert().get("notAfter")
                s.sendall(("GET /health HTTP/1.1\r\nHost: %s\r\nConnection: close\r\n\r\n" % domain).encode())
                head = s.recv(256).decode("latin-1").split("\r\n")[0].split()
                return expiry, int(head[1]) if len(head) > 1 and head[1].isdigit() else None, None
    except ssl.SSLCertVerificationError as e:
        return None, None, "no valid certificate yet (%s)" % e.verify_message
    except (OSError, ssl.SSLError) as e:
        return None, None, str(e) or type(e).__name__


def health_text(status):
    return {
        200: "the box is connected (HTTP 200)",
        502: "the relay works, but no box is connected (HTTP 502)",
    }.get(status, "HTTP %s" % status)


# ---------- up ----------


def step(title):
    say("• " + title)


def cmd_up(a, files):
    cfg = files.load()
    for k in SETTINGS:
        v = getattr(a, k, None)
        if v is not None:
            cfg[k] = v
    if not cfg["project"]:
        ok, out, _ = GCloud(None).run("config", "get-value", "project", check=False)
        cfg["project"] = (out or "").strip() or None
    if not cfg["project"]:
        die("which project? Pass --project (it is remembered)")
    if not cfg["domain"]:
        die("which domain? Pass --domain, e.g. --domain mcp.example.com (it is remembered)")
    if not re.match(r"^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$", cfg["domain"]):
        die("%r is not a domain name" % cfg["domain"])
    zone = zone_of(cfg)
    if not zone.startswith(cfg["region"] + "-"):
        die("zone %s is not in region %s" % (zone, cfg["region"]))
    if cfg["acme_email"] and not re.match(r"^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$", cfg["acme_email"]):
        die("%r does not look like an e-mail address" % cfg["acme_email"])
    tunnel_key = tunnel_key_of(files, a.tunnel_key)
    gc = GCloud(cfg["project"], a.dry_run)
    name = cfg["name"]

    step("gcloud")
    ok, out, _ = gc.run("auth", "list", "--filter=status:ACTIVE", "--format=value(account)", check=False)
    if not (out or "").strip():
        die("gcloud is not logged in: run gcloud auth login")

    step("files in %s" % files.root)
    if not a.dry_run:
        files.ensure_dir()
        files.save(cfg)
        if keygen(files.host_key, "%s host key" % name):
            say("  made the relay's SSH host key")
        if keygen(files.admin_key, "%s admin" % name):
            say("  made the administrator key")
        if tunnel_key and (not files.tunnel_key.exists() or read_key(files.tunnel_key) != tunnel_key):
            write(files.tunnel_key, tunnel_key + "\n")
            say("  took the box's tunnel key from %s" % (a.tunnel_key or BOX_TUNNEL_KEY))
    elif not files.host_key.exists():
        die("--dry-run needs the keys `up` makes; run it once without")

    step("APIs")
    apis = ["compute.googleapis.com"] + (["dns.googleapis.com"] if cfg["dns_zone"] else [])
    for api in apis:
        _, out, _ = gc.run("services", "list", "--enabled", "--filter=config.name=" + api, "--format=value(config.name)")
        if api not in out:
            gc.run("services", "enable", api, mutate=True)

    step("network %s" % name)
    net = gc.get("compute", "networks", "describe", name)
    if net is None:
        gc.run("compute", "networks", "create", name, "--subnet-mode=auto", mutate=True)

    step("firewall")
    for fw_name, (rules, ranges) in firewall_rules(cfg).items():
        fw = gc.get("compute", "firewall-rules", "describe", fw_name)
        flags = ["--rules=" + ",".join(rules), "--source-ranges=" + ",".join(ranges), "--target-tags=" + name]
        if fw is None:
            gc.run("compute", "firewall-rules", "create", fw_name, "--network=" + name, "--direction=INGRESS",
                   "--action=ALLOW", *flags, mutate=True)  # fmt: skip
        elif (rules_of(fw), sorted(fw.get("sourceRanges") or []), sorted(fw.get("targetTags") or [])) != (
            sorted(rules), ranges, [name]
        ):
            gc.run("compute", "firewall-rules", "update", fw_name, *flags, mutate=True)

    step("address")
    addr = gc.get("compute", "addresses", "describe", name, "--region=" + cfg["region"])
    if addr is None:
        gc.run("compute", "addresses", "create", name, "--region=" + cfg["region"], mutate=True)
        addr = gc.get("compute", "addresses", "describe", name, "--region=" + cfg["region"]) if not a.dry_run else None
    ip = addr["address"] if addr else "<new address>"
    say("  %s" % ip)

    if cfg["dns_zone"]:
        step("DNS: %s in zone %s" % (cfg["domain"], cfg["dns_zone"]))
        fqdn = cfg["domain"].rstrip(".") + "."
        rec = gc.get("dns", "record-sets", "describe", fqdn, "--type=A", "--zone=" + cfg["dns_zone"])
        if rec is None:
            gc.run("dns", "record-sets", "create", fqdn, "--type=A", "--ttl=300", "--rrdatas=" + ip,
                   "--zone=" + cfg["dns_zone"], mutate=True)  # fmt: skip
        elif rec.get("rrdatas") != [ip]:
            gc.run("dns", "record-sets", "update", fqdn, "--type=A", "--ttl=300", "--rrdatas=" + ip,
                   "--zone=" + cfg["dns_zone"], mutate=True)  # fmt: skip

    step("instance %s in %s" % (name, zone))
    md = desired_metadata(cfg, files, tunnel_key)
    inst = gc.get("compute", "instances", "describe", name, "--zone=" + zone)
    if inst is not None and a.recreate:
        gc.run("compute", "instances", "delete", name, "--zone=" + zone, mutate=True)
        inst = None
    with metadata_files(md) as from_file:
        if inst is None:
            gc.run("compute", "instances", "create", name, "--zone=" + zone,
                   "--machine-type=" + cfg["machine_type"],
                   "--image-family=" + cfg["image_family"], "--image-project=" + cfg["image_project"],
                   "--boot-disk-size=%dGB" % int(cfg["disk_gb"]), "--boot-disk-type=" + cfg["disk_type"],
                   "--network=" + name, "--address=" + ip, "--tags=" + name,
                   "--no-service-account", "--no-scopes",
                   "--shielded-secure-boot", "--shielded-vtpm", "--shielded-integrity-monitoring",
                   "--metadata-from-file=" + from_file(md), mutate=True)  # fmt: skip
        else:
            if inst.get("status") in ("TERMINATED", "STOPPED", "SUSPENDED"):
                gc.run("compute", "instances", "start", name, "--zone=" + zone, mutate=True)
            have = metadata_of(inst)
            changed = {k: v for k, v in md.items() if have.get(k) != v}
            gone = sorted(k for k in MANAGED if k in have and k not in md)
            if changed:
                say("  new settings: %s" % ", ".join(sorted(changed)))
                gc.run("compute", "instances", "add-metadata", name, "--zone=" + zone,
                       "--metadata-from-file=" + from_file(changed), mutate=True)  # fmt: skip
            if gone:
                gc.run("compute", "instances", "remove-metadata", name, "--zone=" + zone, "--keys=" + ",".join(gone),
                       mutate=True)  # fmt: skip
            drift = []
            if last(inst.get("machineType")) != cfg["machine_type"]:
                drift.append("it is a %s, not a %s" % (last(inst.get("machineType")), cfg["machine_type"]))
            if nat_ip(inst) and addr and nat_ip(inst) != ip:
                drift.append("its address is %s, not %s" % (nat_ip(inst), ip))
            for d in drift:
                say("  ! %s: gcp-tunnel up --recreate makes it anew (the address and the keys stay)" % d)

    if a.dry_run:
        say("\n(dry run: nothing was changed)")
        return 0

    step("waiting for the relay to apply settings %s" % md["mcp-revision"])
    state = wait_ready(gc, cfg, md["mcp-revision"])
    if state != "ready":
        say("\nThe relay's startup script did not finish (%s). Its output:\n" % state)
        show_logs(gc, cfg, 40)
        return 1

    host_pub = public(files.host_key)
    write(files.known_hosts, "%s,%s %s\n" % (ip, cfg["domain"], host_pub))
    write(files.relay_nix, relay_nix(cfg, ip, host_pub))

    step("checking from outside")
    # What is left is for the operator to do, and is listed: `up` itself has done its part.
    report(cfg, files, ip, up=True)
    return 0


@contextlib.contextmanager
def metadata_files(md):
    """A function that writes metadata values to files and gives gcloud's --metadata-from-file value for them."""
    with tempfile.TemporaryDirectory(prefix="gcp-tunnel-") as d:

        def from_file(items):
            parts = []
            for k, v in sorted(items.items()):
                p = Path(d) / k
                fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
                with os.fdopen(fd, "w") as f:
                    f.write(v)
                parts.append("%s=%s" % (k, p))
            return ",".join(parts)

        yield from_file


def wait_ready(gc, cfg, revision):
    end = time.time() + WAIT_READY_S
    seen = None
    while time.time() < end:
        st = guest_status(gc, cfg)
        if st != seen and st:
            say("  %s" % st)
            seen = st
        if st == "ready " + revision:
            return "ready"
        if st and st.startswith("failed " + revision):
            return st
        time.sleep(10)
    return "no word from it in %d minutes" % (WAIT_READY_S // 60)


def relay_nix(cfg, ip, host_pub):
    return """# Written by relay/gcp-tunnel up: the relay this box opens its tunnel to. Put these in the box's configuration.
{{
  services.compu-connect = {{
    domain = "{domain}";
    relay.host = "{ip}";
    relay.hostPublicKey = "{key}";
  }};
}}
""".format(domain=cfg["domain"], ip=ip, key=host_pub)


def report(cfg, files, ip, up=False):
    """What works, from outside; 0 if all of it."""
    ok = True
    ips = resolve(cfg["domain"])
    if ip in ips:
        say("  DNS        %s points here" % cfg["domain"])
    else:
        ok = False
        say("  DNS        %s points %s, not here" % (cfg["domain"], "to " + ", ".join(ips) if ips else "nowhere"))
    expiry, status, why = https_check(ip, cfg["domain"])
    if why:
        ok = False
        if ip not in ips:
            why = "no certificate yet: Caddy gets one once %s points here (%s)" % (cfg["domain"], why)
        say("  HTTPS      %s" % why)
    else:
        say("  HTTPS      certificate valid until %s; %s" % (expiry, health_text(status)))
        ok = ok and status == 200
    has_key = files.tunnel_key.exists()
    if has_key:
        say("  tunnel key %s" % files.tunnel_key.read_text().strip()[-40:])
    else:
        ok = False
        say("  tunnel key none yet: no box can connect")

    if up:
        say("")
        todo = []
        if ip not in ips and not cfg["dns_zone"]:
            todo.append("Point an A record for %s at %s, where your domain's DNS is. The certificate follows by "
                        "itself within minutes of that." % (cfg["domain"], ip))  # fmt: skip
        if not has_key:
            todo.append("Give the relay the box's tunnel key: on the box, /var/lib/mcp-tunnel/id_ed25519.pub; then "
                        "gcp-tunnel up --tunnel-key that-file.")  # fmt: skip
        if status != 200:
            todo.append("Give the box these settings (also in %s), and rebuild it:\n\n%s" % (
                files.relay_nix, indent(relay_nix(cfg, ip, public(files.host_key)))))  # fmt: skip
        if todo:
            say("Left to do:\n")
            for i, t in enumerate(todo, 1):
                say("%d. %s\n" % (i, t))
        else:
            say("All up: https://%s/mcp reaches the box. Tokens: mcpctl create, on the box." % cfg["domain"])
    return 0 if ok else 1


def indent(text):
    return "\n".join("    " + line if line else "" for line in text.splitlines())


# ---------- the other commands ----------


def need_config(files):
    cfg = files.load()
    if not files.config.exists() or not cfg.get("project"):
        die("nothing set up yet from %s: run gcp-tunnel up first" % files.root)
    return cfg, GCloud(cfg["project"])


def cmd_status(a, files):
    cfg, gc = need_config(files)
    name, zone = cfg["name"], zone_of(cfg)
    say("project    %s, files in %s" % (cfg["project"], files.root))
    net = gc.get("compute", "networks", "describe", name)
    say("network    %s" % (name if net else "missing"))
    for fw_name, (rules, ranges) in firewall_rules(cfg).items():
        fw = gc.get("compute", "firewall-rules", "describe", fw_name)
        if fw is None:
            say("firewall   %s missing" % fw_name)
        else:
            say("firewall   %s: %s from %s" % (fw_name, " ".join(rules_of(fw)), ",".join(fw.get("sourceRanges") or [])))
    addr = gc.get("compute", "addresses", "describe", name, "--region=" + cfg["region"])
    say("address    %s" % ("%s (%s)" % (addr["address"], addr.get("status", "").lower()) if addr else "missing"))
    inst = gc.get("compute", "instances", "describe", name, "--zone=" + zone)
    if inst is None:
        say("instance   missing")
        return 1
    have = metadata_of(inst).get("mcp-revision")
    want = desired_metadata(cfg, files)["mcp-revision"] if files.host_key.exists() else None
    say("instance   %s in %s: %s, %s" % (name, zone, inst.get("status"), last(inst.get("machineType"))))
    st = guest_status(gc, cfg)
    say("settings   %s%s" % (st or "no word from the relay yet",
                             "" if have == want else "; out of date, `gcp-tunnel up` applies the current ones"))  # fmt: skip
    ip = nat_ip(inst) or (addr or {}).get("address")
    if not ip:
        return 1
    ok = report(cfg, files, ip) == 0
    return 0 if ok and inst.get("status") == "RUNNING" and st == "ready " + str(have) and have == want else 1


def cmd_nix(a, files):
    if not files.relay_nix.exists():
        die("no relay.nix yet: run gcp-tunnel up")
    sys.stdout.write(files.relay_nix.read_text())
    return 0


def relay_ip(gc, cfg):
    addr = gc.get("compute", "addresses", "describe", cfg["name"], "--region=" + cfg["region"])
    if not addr:
        die("the relay has no address: run gcp-tunnel up")
    return addr["address"]


def cmd_ssh(a, files):
    cfg, gc = need_config(files)
    ip = relay_ip(gc, cfg)
    argv = ["ssh", "-i", str(files.admin_key), "-o", "IdentitiesOnly=yes", "-o", "UserKnownHostsFile=%s" % files.known_hosts,
            "-o", "StrictHostKeyChecking=yes", "%s@%s" % (cfg["admin"], ip), *a.command]  # fmt: skip
    os.execvp("ssh", argv)


def show_logs(gc, cfg, n):
    ok, out, err = gc.run("compute", "instances", "get-serial-port-output", cfg["name"], "--zone=" + zone_of(cfg),
                          check=False)  # fmt: skip
    if not ok:
        say(err.strip())
        return 1
    lines = [ln for ln in out.splitlines() if "startup-script" in ln or "mcp-relay" in ln]
    say("\n".join(lines[-n:]) or "(nothing from the startup script yet)")
    return 0


def cmd_logs(a, files):
    cfg, gc = need_config(files)
    return show_logs(gc, cfg, a.lines)


def cmd_down(a, files):
    cfg, gc = need_config(files)
    name, zone, region = cfg["name"], zone_of(cfg), cfg["region"]
    addr = gc.get("compute", "addresses", "describe", name, "--region=" + region)
    plan = []
    rec = None
    if cfg["dns_zone"] and addr:
        rec = gc.get("dns", "record-sets", "describe", cfg["domain"].rstrip(".") + ".", "--type=A", "--zone=" + cfg["dns_zone"])
        if rec and rec.get("rrdatas") == [addr["address"]]:
            plan.append(("the A record of %s" % cfg["domain"], ["dns", "record-sets", "delete", cfg["domain"].rstrip(".") + ".",
                                                               "--type=A", "--zone=" + cfg["dns_zone"]]))  # fmt: skip
    if gc.get("compute", "instances", "describe", name, "--zone=" + zone):
        plan.append(("instance %s and its disk" % name, ["compute", "instances", "delete", name, "--zone=" + zone]))
    for fw_name in firewall_rules(cfg):
        if gc.get("compute", "firewall-rules", "describe", fw_name):
            plan.append(("firewall rule %s" % fw_name, ["compute", "firewall-rules", "delete", fw_name]))
    if gc.get("compute", "networks", "describe", name):
        plan.append(("network %s" % name, ["compute", "networks", "delete", name]))
    if addr and not a.keep_address:
        plan.append(("address %s" % addr["address"], ["compute", "addresses", "delete", name, "--region=" + region]))
    if not plan:
        say("nothing to delete")
        return 0
    say("This deletes, in project %s:\n%s" % (cfg["project"], "\n".join("  " + what for what, _ in plan)))
    if addr and not a.keep_address:
        say("A new address later means changing DNS and the box's relay.host; --keep-address keeps it.")
    if not a.yes:
        if not sys.stdin.isatty():
            die("pass --yes to delete without being asked")
        if input("Go ahead? [y/N] ").strip().lower() not in ("y", "yes"):
            return 1
    for what, args in plan:
        gc.run(*args, mutate=True)
    say("deleted; the files in %s are kept" % files.root)
    return 0


# ---------- main ----------


def main():
    ap = argparse.ArgumentParser(prog="gcp-tunnel", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dir", help="where its files are kept (default %s)" % DIR)
    sub = ap.add_subparsers(dest="cmd", required=True, metavar="COMMAND")

    s = sub.add_parser("up", help="create or update everything")
    s.add_argument("--project")
    s.add_argument("--domain", help="the name to serve, e.g. mcp.example.com")
    s.add_argument("--name", help="what its resources are called (default mcp-relay)")
    s.add_argument("--region", help="default us-east1")
    s.add_argument("--zone", help="default the region's -b zone")
    s.add_argument("--machine-type", dest="machine_type")
    s.add_argument("--image-family", dest="image_family", help="default debian-12")
    s.add_argument("--acme-email", dest="acme_email", help="where Let's Encrypt may write about the certificate")
    s.add_argument("--dns-zone", dest="dns_zone", help="a Cloud DNS zone in the project to keep the A record in")
    s.add_argument("--ssh-from", dest="ssh_from", type=lambda v: sorted(v.split(",")),
                   help="where SSH may come from, comma-separated CIDRs (default anywhere: the box's address may change)")  # fmt: skip
    s.add_argument("--tunnel-key", dest="tunnel_key", metavar="FILE", help="the box's /var/lib/mcp-tunnel/id_ed25519.pub")
    s.add_argument("--recreate", action="store_true", help="delete the instance and make it anew; address and keys stay")
    s.add_argument("--dry-run", action="store_true", help="say what would be changed, and change nothing")

    sub.add_parser("status", help="what exists, and whether it works")
    sub.add_parser("nix", help="the box's settings for this relay")
    s = sub.add_parser("ssh", help="log in to the relay")
    s.add_argument("command", nargs=argparse.REMAINDER)
    s = sub.add_parser("logs", help="what the startup script said")
    s.add_argument("--lines", type=int, default=60)
    s = sub.add_parser("down", help="delete everything in the project; keep the files")
    s.add_argument("--keep-address", action="store_true", help="keep the static address, so DNS and the box stay right")
    s.add_argument("--yes", action="store_true", help="do not ask")
    a = ap.parse_args()

    files = Files(a.dir or DIR)
    if a.cmd != "nix":
        find_gcloud()
    if a.cmd in ("up", "ssh") and not shutil.which("ssh-keygen"):
        die("ssh-keygen is not installed")
    files.root.mkdir(mode=0o700, parents=True, exist_ok=True)
    with open(files.root / ".lock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            die("another gcp-tunnel is running on %s" % files.root)
        return {"up": cmd_up, "status": cmd_status, "nix": cmd_nix, "ssh": cmd_ssh, "logs": cmd_logs,
                "down": cmd_down}[a.cmd](a, files)  # fmt: skip


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
